[Unit]
Description=Fleeting 随笔（Go 单文件服务）
Documentation=https://liangz77.cn/private
After=network.target

[Service]
Type=simple
User=fleeting
Group=fleeting
WorkingDirectory=/srv/apps/fleeting/current
Environment=FLEETING_CONFIG=/srv/apps/fleeting/shared/config.local.json
Environment=STATIC_ROOT=/srv/apps/fleeting/current/web
Environment=PORT=3010
Environment=HOST=127.0.0.1
ExecStart=/srv/apps/fleeting/current/fleeting
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/apps/fleeting/shared

[Install]
WantedBy=multi-user.target
